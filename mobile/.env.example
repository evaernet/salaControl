# URL de la API de Laravel (con /api al final).
# Si no se define, la app usa la IP de la computadora que corre Expo y el puerto 8000.
# Ejemplos:
#   Celular con Expo Go en la misma red Wi-Fi: http://192.168.0.10:8000/api
#   Emulador de Android:                          http://10.0.2.2:8000/api
#   Navegador o simulador de iOS:                 http://localhost:8000/api
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api
